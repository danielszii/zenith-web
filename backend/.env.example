NODE_ENV=development
PORT=3000

# Uma ou mais origens do portal, separadas por vírgula e sem barra final.
FRONTEND_URL=http://localhost:5173

# Runtime da API: use Transaction pooler (porta 6543) no Supabase.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5"

# Prisma CLI/migrations: use Direct connection (porta 5432). Se sua rede não
# tiver IPv6, use o Session pooler do Supabase, também na porta 5432.
DIRECT_URL="postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio